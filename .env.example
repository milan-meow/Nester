# Copy to .env:  cp .env.example .env
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-hex-chars-from-the-command-above-xxxxxxxx
INTERNAL_API_KEY=replace-with-another-64-hex-chars-xxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Local dev without Docker (npm run dev): leave these unset → in-memory DB + event bus.
# MONGO_URL=mongodb://localhost:27017
# REDIS_URL=redis://localhost:6379
