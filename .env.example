# Copy to .env and change the secret before deploying anywhere real.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Leave MONGO_URL / REDIS_URL empty to run with in-memory stores (local dev only).
MONGO_URL=mongodb://mongo:27017
REDIS_URL=redis://redis:6379

GATEWAY_PORT=8080
CORS_ORIGIN=http://localhost:5173
